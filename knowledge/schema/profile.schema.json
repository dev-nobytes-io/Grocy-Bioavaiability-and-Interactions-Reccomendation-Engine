{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dev-nobytes-io/Grocy-Bioavaiability-and-Interactions-Reccomendation-Engine/knowledge/schema/profile.schema.json",
  "title": "Health profile",
  "description": "A user-controlled, local-only health profile. Every field is optional. Missing answers make the engine more cautious. Health information shapes suggestions and is never treated. See docs/science/health-profile.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_on": { "type": "string", "format": "date" },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sex_for_reference_values": {
          "description": "Chooses sex-specific reference intakes and upper limits. not_stated makes the engine use the more cautious value.",
          "enum": ["female", "male", "not_stated"]
        },
        "gender_identity": { "type": "string", "maxLength": 60, "description": "Display only. Never used in any calculation." },
        "birth_year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "age_years": { "type": "integer", "minimum": 0, "maximum": 130, "description": "Use when birth year is not given." },
        "height_cm": { "type": "number", "exclusiveMinimum": 0, "maximum": 272 },
        "weight_kg": { "type": "number", "exclusiveMinimum": 0, "maximum": 400 },
        "weight_measured_on": { "type": "string", "format": "date" },
        "body_fat_percent": { "type": "number", "minimum": 1, "maximum": 75 },
        "body_fat_method": { "enum": ["dexa", "bioimpedance", "skinfold", "tape", "estimate", "other"] },
        "waist_cm": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 }
      },
      "dependentRequired": { "body_fat_percent": ["body_fat_method"] }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/training_type" } },
        "sessions_per_week": { "type": "integer", "minimum": 0, "maximum": 21 },
        "experience_years": { "type": "number", "minimum": 0, "maximum": 80 },
        "current_phase": {
          "enum": ["hypertrophy_block", "strength_block", "deload", "competition_prep", "endurance_base", "maintenance", "off_season", "other"]
        },
        "upcoming_sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "type"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "time": { "$ref": "#/$defs/clock_time" },
              "type": { "$ref": "#/$defs/training_type" },
              "intensity": { "enum": ["easy", "moderate", "hard"] }
            }
          }
        },
        "current_injuries": {
          "type": "array",
          "description": "For the user's own record and training context. The engine reads flag.recent_injury_or_surgery, not this text.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": { "type": "string", "maxLength": 200 },
              "since": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "diet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": { "enum": ["omnivore", "vegetarian", "vegan", "pescatarian", "other"] },
        "restrictions": {
          "type": "array",
          "description": "Foods never suggested, for religious, ethical or other reasons. Food names are resolved to food classes with the user's confirmation.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "foods"],
            "properties": {
              "reason": { "enum": ["religious", "ethical", "other"] },
              "foods": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "note": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "dislikes": { "type": "array", "items": { "type": "string" }, "description": "Never suggested. Not a health statement." },
        "meal_times": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "time"],
            "properties": {
              "name": { "type": "string", "maxLength": 40 },
              "time": { "$ref": "#/$defs/clock_time" }
            }
          }
        }
      }
    },
    "allergies": {
      "type": "object",
      "additionalProperties": false,
      "description": "status maps to flag.allergens: none is false, listed is true, unknown is unknown.",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["none", "listed", "unknown"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allergen"],
            "properties": {
              "allergen": { "type": "string", "description": "Resolved to a food class with the user's confirmation." },
              "severity": {
                "description": "Shown to the user. Never loosens the allergy gate.",
                "enum": ["mild", "moderate", "severe", "anaphylaxis", "not_sure"]
              }
            }
          }
        }
      },
      "if": { "properties": { "status": { "const": "listed" } } },
      "then": { "required": ["items"], "properties": { "items": { "minItems": 1 } } }
    },
    "intolerances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flags": { "$ref": "#/$defs/flag_answers" },
        "other_foods": { "type": "array", "items": { "type": "string" }, "description": "Other foods that upset you. Treated like dislikes: never suggested." }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flags": { "$ref": "#/$defs/flag_answers" }
      }
    },
    "recent_events": {
      "type": "array",
      "description": "Each event applies from started_on until the expires_after_days of its flag in gates.yaml have passed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flag", "started_on"],
        "properties": {
          "flag": { "$ref": "#/$defs/flag_id" },
          "started_on": { "type": "string", "format": "date" },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "medicines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "array",
          "description": "Free text for the user's own reference. Never parsed, matched or checked against anything.",
          "items": { "type": "string", "maxLength": 200 }
        },
        "flags": { "$ref": "#/$defs/flag_answers" }
      }
    },
    "supplements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "amount", "frequency"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "nutrient": { "type": "string", "description": "The nutrient or compound the amount refers to, when the product has one main ingredient." },
          "amount": { "$ref": "#/$defs/amount_range" },
          "frequency": { "enum": ["daily", "training_days", "weekly", "as_needed"] },
          "doses_per_day": { "type": "integer", "minimum": 1, "maximum": 12 },
          "dsld_id": { "type": "string", "pattern": "^[0-9]{1,9}$", "description": "Optional NIH Dietary Supplement Label Database identifier." },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "life_stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flags": { "$ref": "#/$defs/flag_answers" },
        "menstrual_status": {
          "enum": ["menstruating", "not_menstruating", "perimenopause", "postmenopause", "not_applicable", "prefer_not_to_say"]
        }
      }
    },
    "daily_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date"],
      "description": "Today's check-in. Ignored when the date is not today.",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "sleep_hours": { "type": "number", "minimum": 0, "maximum": 24 },
        "sleep_quality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "soreness": { "type": "integer", "minimum": 0, "maximum": 10 },
        "energy": { "type": "integer", "minimum": 1, "maximum": 5 },
        "todays_goal": { "$ref": "#/$defs/goal" }
      }
    }
  },
  "$defs": {
    "flag_id": { "type": "string", "pattern": "^flag\\.[a-z0-9_]+$" },
    "flag_value": {
      "description": "true, false, or unknown. unknown and a missing flag are treated the same way.",
      "enum": [true, false, "unknown"]
    },
    "flag_answers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/flag_id" },
      "additionalProperties": { "$ref": "#/$defs/flag_value" }
    },
    "amount_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "unit"],
      "description": "Per dose. Stored as a range because labels and contents differ. min must not exceed max; the validator checks this.",
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["g", "mg", "mcg", "IU", "mL"] }
      }
    },
    "clock_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "training_type": { "enum": ["resistance", "endurance", "mixed", "team_sport", "combat_sport", "mobility", "other"] },
    "goal": {
      "enum": ["muscle_repair", "glycogen_restoration", "connective_tissue", "adaptation", "sleep", "micronutrient_status", "hydration", "gut_comfort", "general"]
    }
  }
}
